{
  "methods": {
    "pick": {
      "entry_point": 2363702380,
      "argument": "picks.pick_arguments",
      "return": "picks.empty_object",
      "read_only": false,
      "description": "Make or change your pick for a round of a game. Needs the player's signature. Refused when the game is off, the round is locked or not open yet, the choice doesn't fit the game, it is already your pick, changes or today's picks are used up."
    },
    "authorize": {
      "entry_point": 1244511632,
      "argument": "koinos.chain.authorize_arguments",
      "return": "koinos.chain.authorize_result",
      "read_only": false,
      "description": "Check if authorized"
    },
    "get_pick": {
      "entry_point": 4083214051,
      "argument": "picks.get_pick_arguments",
      "return": "picks.get_pick_result",
      "read_only": true,
      "description": "One wallet's pick for one round of a game (empty if none)."
    },
    "list_picks": {
      "entry_point": 2118033200,
      "argument": "picks.list_picks_arguments",
      "return": "picks.list_picks_result",
      "read_only": true,
      "description": "Every pick for a round of a game, in address order, up to limit (at most 100) at a time. Pass the last address you got as start_after for the next page."
    },
    "get_usage": {
      "entry_point": 1236253562,
      "argument": "picks.get_usage_arguments",
      "return": "picks.get_usage_result",
      "read_only": true,
      "description": "Picks a wallet has made today (UTC) in a game, and the daily limit."
    },
    "get_config": {
      "entry_point": 3159346644,
      "argument": "picks.get_config_arguments",
      "return": "picks.config",
      "read_only": true,
      "description": "The owner, a proposed new owner and an announced upgrade."
    },
    "get_game": {
      "entry_point": 1871540943,
      "argument": "picks.get_game_arguments",
      "return": "picks.get_game_result",
      "read_only": true,
      "description": "One game's rules and any announced change to them."
    },
    "list_games": {
      "entry_point": 49260435,
      "argument": "picks.list_games_arguments",
      "return": "picks.list_games_result",
      "read_only": true,
      "description": "Every registered game, in id order."
    },
    "list_pending": {
      "entry_point": 1809552309,
      "argument": "picks.list_pending_arguments",
      "return": "picks.list_pending_result",
      "read_only": true,
      "description": "Announced game changes that can still be applied, in game id order, up to limit (at most 50) at a time. Pass the last game id you got as start_after for the next page."
    },
    "announce_game": {
      "entry_point": 4158087113,
      "argument": "picks.announce_game_arguments",
      "return": "picks.eta_result",
      "read_only": false,
      "description": "Announce a new game, or new settings for a game (owner only). Takes effect with apply_game 48 hours later. A game's shape can't change once registered."
    },
    "apply_game": {
      "entry_point": 1543470019,
      "argument": "picks.apply_game_arguments",
      "return": "picks.empty_object",
      "read_only": false,
      "description": "Put an announced game change in force, from 48 hours after it was announced and for 7 days. Anyone may call it."
    },
    "tighten_game": {
      "entry_point": 2491882306,
      "argument": "picks.tighten_game_arguments",
      "return": "picks.empty_object",
      "read_only": false,
      "description": "Make a game stricter at once (owner only): switch it off, lower its caps, lock earlier or open later. Nothing looser is allowed. It also drops any announced change for that game."
    },
    "cancel_game_change": {
      "entry_point": 3590283698,
      "argument": "picks.cancel_game_change_arguments",
      "return": "picks.empty_object",
      "read_only": false,
      "description": "Drop an announced game change (owner only)."
    },
    "propose_owner": {
      "entry_point": 198312784,
      "argument": "picks.propose_owner_arguments",
      "return": "picks.eta_result",
      "read_only": false,
      "description": "Propose a new owner (owner only). They can accept from 48 hours later. Proposing again replaces it; an empty owner cancels."
    },
    "accept_owner": {
      "entry_point": 3668871220,
      "argument": "picks.accept_owner_arguments",
      "return": "picks.empty_object",
      "read_only": false,
      "description": "Become the owner (the proposed owner, 48 hours after the proposal). Every game change the previous owner announced can no longer be applied, and any announced upgrade is cleared."
    },
    "schedule_upgrade": {
      "entry_point": 2777493725,
      "argument": "picks.schedule_upgrade_arguments",
      "return": "picks.eta_result",
      "read_only": false,
      "description": "Announce new code by its sha256 (owner only). It can be uploaded, signed by the owner, from 48 hours later and for 7 days. An all-zero or empty hash cancels."
    }
  },
