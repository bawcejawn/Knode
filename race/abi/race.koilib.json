{
  "methods": {
    "pick": {
      "entry_point": 2363702380,
      "argument": "race.pick_arguments",
      "return": "race.empty_object",
      "read_only": false,
      "description": "Pick a horse for a race (or change your pick). Needs the player's signature. Refused once the race has started, for races more than 24 hours ahead, and after today's picks are used up."
    },
    "get_pick": {
      "entry_point": 4083214051,
      "argument": "race.get_pick_arguments",
      "return": "race.get_pick_result",
      "read_only": true,
      "description": "One wallet's pick for one race (empty if none)."
    },
    "list_picks": {
      "entry_point": 2118033200,
      "argument": "race.list_picks_arguments",
      "return": "race.list_picks_result",
      "read_only": true,
      "description": "Every pick for a race, in address order, up to limit (at most 100) at a time. Pass the last address you got as start_after for the next page."
    },
    "get_usage": {
      "entry_point": 1236253562,
      "argument": "race.get_usage_arguments",
      "return": "race.get_usage_result",
      "read_only": true,
      "description": "Picks a wallet has made today (UTC) and the daily limit."
    },
    "get_config": {
      "entry_point": 3159346644,
      "argument": "race.get_config_arguments",
      "return": "race.config",
      "read_only": true,
      "description": "The settings."
    },
    "set_config": {
