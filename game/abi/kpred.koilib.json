      "entry_point": 3017869156,
      "argument": "kpred.resolve_question_arguments",
      "return": "kpred.resolve_question_result",
      "read_only": false,
      "description": "Resolve a question after its window (operator only). outcome = winning option (0-based) or 1000 for void."
    },
    "correct_question": {
      "entry_point": 1086330229,
      "argument": "kpred.correct_question_arguments",
      "return": "kpred.correct_question_result",
