    },
    "cancel_upgrade": {
      "entry_point": 187647932,
      "argument": "kpred.cancel_upgrade_arguments",
      "return": "kpred.cancel_upgrade_result",
      "read_only": false,
      "description": "Cancel an announced code upgrade (owner only)."
    },
