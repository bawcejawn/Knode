    },
    "seed_deposit_vhp": {
      "entry_point": 1909552177,
      "argument": "kpred.seed_deposit_vhp_arguments",
      "return": "kpred.seed_deposit_vhp_result",
      "read_only": false,
      "description": "Add seed VHP (seed owner; approve first). Produces for the pool, never plays."
    },
    "seed_deposit_koin": {
      "entry_point": 332839423,
      "argument": "kpred.seed_deposit_koin_arguments",
      "return": "kpred.seed_deposit_koin_result",
