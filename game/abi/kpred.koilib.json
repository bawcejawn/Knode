      "read_only": true,
      "description": "One week's results."
    },
    "list_players": {
      "entry_point": 1154979652,
      "argument": "kpred.list_players_arguments",
      "return": "kpred.list_players_result",
      "read_only": true,
      "description": "Page through all players, each with their entry for a week (up to 50 per page, after address `start`)."
    },
    "init": {
      "entry_point": 3142846090,
      "argument": "kpred.init_arguments",
      "return": "kpred.init_result",
      "read_only": false,
      "description": "One-time setup. Must be signed by the contract's own key."
    },
    "deposit_vhp": {
      "entry_point": 2396116866,
      "argument": "kpred.deposit_vhp_arguments",
      "return": "kpred.deposit_vhp_result",
      "read_only": false,
      "description": "Stake VHP (approve this contract for `amount` VHP in the same transaction). Counts from next week."
    },
    "deposit_koin": {
      "entry_point": 533371977,
      "argument": "kpred.deposit_koin_arguments",
      "return": "kpred.deposit_koin_result",
      "read_only": false,
      "description": "Stake KOIN: burned 1:1 into VHP (approve this contract for `amount` KOIN first). Counts from next week."
    },
    "withdraw": {
      "entry_point": 3262063323,
      "argument": "kpred.withdraw_arguments",
      "return": "kpred.withdraw_result",
      "read_only": false,
      "description": "Withdraw staked VHP at any time. Withdrawing voids this week's answers."
    },
    "answer": {
      "entry_point": 229977920,
      "argument": "kpred.answer_arguments",
      "return": "kpred.answer_result",
      "read_only": false,
      "description": "Answer a question (free: the contract pays the Mana). Needs an active stake of at least min_stake."
    },
    "settle": {
      "entry_point": 1751705661,
      "argument": "kpred.settle_arguments",
      "return": "kpred.settle_result",
      "read_only": false,
      "description": "Count a player's points for a closed week (anyone can call it; free)."
    },
    "claim": {
      "entry_point": 3709549617,
      "argument": "kpred.claim_arguments",
      "return": "kpred.claim_result",
      "read_only": false,
      "description": "Claim a week's reward in VHP (free). Sent to the player's wallet."
    },
    "compound": {
      "entry_point": 3993893244,
      "argument": "kpred.compound_arguments",
      "return": "kpred.compound_result",
      "read_only": false,
      "description": "Burn the contract's spare KOIN (above the Mana reserve and unpaid fees) into VHP."
    },
    "close_week": {
      "entry_point": 621611198,
      "argument": "kpred.close_week_arguments",
      "return": "kpred.close_week_result",
      "read_only": false,
      "description": "Close a finished week: measure the gain, take fees, open settlement. Weeks close in order. Also happens automatically on any game action."
    },
    "finalize_week": {
      "entry_point": 2354145685,
      "argument": "kpred.finalize_week_arguments",
      "return": "kpred.finalize_week_result",
      "read_only": false,
      "description": "After settlement ends: find the winners' cutoff (top 30% of eligible stake by points, ties included). Weeks finalize in order. Also happens automatically."
    },
    "post_question": {
      "entry_point": 1179668153,
      "argument": "kpred.post_question_arguments",
      "return": "kpred.post_question_result",
      "read_only": false,
      "description": "Publish a question (operator only)."
    },
