{
  "targets": {
    "debug": {
      "outFile": "build/debug/contract.wasm",
      "textFile": "build/debug/contract.wat",
      "sourceMap": true,
      "debug": true
    },
    "release": {
      "outFile": "build/release/contract.wasm",
      "textFile": "build/release/contract.wat",
      "sourceMap": false,
      "optimizeLevel": 3,
      "shrinkLevel": 2,
      "converge": false,
      "noAssert": false
    }
  },
  "options": {
    "exportStart": "_start",
    "disable": [
      "sign-extension",
      "bulk-memory"
    ],
    "runtime": "stub",
    "disableWarning": [
      "235",
      "228"
    ]
  }
}
